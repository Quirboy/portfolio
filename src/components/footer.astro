---
import { site } from "@/data/site";
const currentYear = new Date().getFullYear();
---
<footer class="w-full py-10 border-t border-[#ffffff10]">
  <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-center justify-between gap-5">
    <p class="text-sm text-[var(--white-icon)]">© {currentYear} {site.name}</p>
    <nav aria-label="Social links" class="flex flex-wrap items-center justify-center gap-5 text-sm">
      <a href={site.github} target="_blank" rel="noopener noreferrer" class="text-[var(--white-icon)] hover:text-white transition">GitHub</a>
      <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="text-[var(--white-icon)] hover:text-white transition">LinkedIn</a>
      <a href={`mailto:${site.email}`} class="text-[var(--white-icon)] hover:text-white transition">Email</a>
    </nav>
    <p class="text-xs text-[var(--white-icon)] text-center">Built with Astro and Tailwind CSS · Hosted on GitHub Pages</p>
  </div>
</footer>
