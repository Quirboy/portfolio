---
interface Props {
  title?: string;
  text?: string;
  button?: string;
}

const {
  title = "Interested in my work?",
  text = "Would you like to know more about one of these learning projects? Get in touch and I’ll be happy to share more details.",
  button = "Contact me",
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<section class="mt-20 pt-12 border-t border-[#ffffff10]">
  <h2 class="text-3xl md:text-4xl font-medium mb-3">{title}</h2>
  <p class="text-[var(--white-icon)] md:text-lg max-w-xl">{text}</p>
  <a
    href={`${base}/#contact`}
    class="inline-flex items-center justify-center mt-6 px-6 py-3 text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-[var(--white-icon-tr)] rounded-full bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
  >
    {button}
  </a>
</section>
