---
import PageLayout from "@/layouts/PageLayout.astro";
import ProjectCard from "@/components/projectCard.astro";
import CtaBlock from "@/components/ctaBlock.astro";
import { caseStudies } from "@/data/caseStudies";
import { projects } from "@/data/projects";

export function getStaticPaths() {
  return caseStudies.map((study) => ({
    params: { slug: study.slug },
    props: { study },
  }));
}

const { study } = Astro.props;
const { Content } = study;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const more = projects.filter((project) => project.slug !== study.slug).slice(0, 3);
---

<PageLayout title={study.title} description={study.summary}>
  <article>
    <a
      href={`${base}/projects`}
      class="inline-flex items-center gap-2 text-[var(--white-icon)] hover:text-white transition-colors mb-8"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5" aria-hidden="true">
        <path d="M7.82843 10.9999H20V12.9999H7.82843L13.1924 18.3638L11.7782 19.778L4 11.9999L11.7782 4.22168L13.1924 5.63589L7.82843 10.9999Z"></path>
      </svg>
      Back to projects
    </a>

    <header class="mb-10">
      <ul class="flex flex-wrap items-center gap-2 mb-4" aria-label="Tags">
        {
          study.tags.map((tag) => (
            <li class="text-xs border border-[var(--white-icon-tr)] rounded-full px-2.5 py-1 text-[var(--sec)]">
              {tag}
            </li>
          ))
        }
        <li class="text-sm text-[var(--white-icon)] ml-1">{study.year}, {study.duration}</li>
      </ul>
      <h1 class="text-4xl md:text-5xl font-medium leading-tight mb-4">{study.title}</h1>
      <p class="text-[var(--white-icon)] md:text-lg leading-relaxed max-w-3xl">{study.summary}</p>
    </header>

    <dl class="grid grid-cols-2 md:grid-cols-4 gap-6 border-y border-[#ffffff10] py-6 mb-8">
      {
        study.facts.map((fact) => (
          <div>
            <dt class="text-sm text-[var(--white-icon)]">{fact.label}</dt>
            <dd class="mt-1 font-medium">{fact.value}</dd>
          </div>
        ))
      }
    </dl>

    <ul class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
      {
        study.stats.map((stat) => (
          <li class="border border-[var(--white-icon-tr)] rounded-xl bg-[#1414149c] p-5">
            <p class="text-3xl font-medium">{stat.value}</p>
            <p class="mt-1 text-sm text-[var(--white-icon)]">{stat.label}</p>
          </li>
        ))
      }
    </ul>

    <img
      src={study.cover}
      alt=""
      class="w-full h-64 md:h-[28rem] object-cover rounded-2xl mb-14"
    />

    <div class="max-w-2xl mx-auto prose-dm">
      <Content />
    </div>
  </article>

  <section class="mt-20 pt-12 border-t border-[#ffffff10]">
    <h2 class="text-3xl md:text-4xl font-medium mb-8">More projects</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {more.map((project) => <ProjectCard project={project} />)}
    </div>
    <a
      href={`${base}/projects`}
      class="inline-flex items-center justify-center mt-8 px-6 py-3 text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-[var(--white-icon-tr)] rounded-full bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
    >
      View all projects
    </a>
  </section>

  <CtaBlock
    title="Got a similar project?"
    text="I'm available for new projects. Tell me about what you're building and let's see if we're a good fit."
  />
</PageLayout>
